import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import (
    accuracy_score,
    confusion_matrix,
    ConfusionMatrixDisplay
)


def load_dataset():
    """
    Load the student performance dataset.
    """
    df = pd.read_csv("student_performance_ml.csv")

    print("\n========== DATASET ==========")
    print(df)

    return df


def analyze_data(df):
    """
    Perform basic data analysis.
    """

    print("\n========== DATA ANALYSIS ==========")

    print("\nFirst 5 Records:")
    print(df.head())

    print("\nLast 5 Records:")
    print(df.tail())

    print("\nRows and Columns:")
    print(df.shape)

    print("\nColumn Names:")
    print(df.columns.tolist())

    print("\nData Types:")
    print(df.dtypes)

    print("\nTotal Students:", len(df))

    print("\nPassed Students:")
    print(len(df[df["FinalResult"] == 1]))

    print("\nFailed Students:")
    print(len(df[df["FinalResult"] == 0]))

    print("\nAverage StudyHours:",
          df["StudyHours"].mean())

    print("Average Attendance:",
          df["Attendance"].mean())

    print("Maximum PreviousScore:",
          df["PreviousScore"].max())

    print("Minimum SleepHours:",
          df["SleepHours"].min())

    print("\nFinalResult Distribution:")
    print(df["FinalResult"].value_counts())

    total_students = len(df)

    passed = len(df[df["FinalResult"] == 1])
    failed = len(df[df["FinalResult"] == 0])

    pass_percentage = (passed / total_students) * 100
    fail_percentage = (failed / total_students) * 100

    print("\nPass Percentage:",
          round(pass_percentage, 2), "%")

    print("Fail Percentage:",
          round(fail_percentage, 2), "%")


def create_visualizations(df):
    """
    Create required visualizations.
    """

    # ----------------------------------------
    # Histogram of StudyHours
    # ----------------------------------------

    plt.figure(figsize=(8, 5))

    plt.hist(
        df["StudyHours"],
        bins=10,
        edgecolor="black"
    )

    plt.title("Distribution of Study Hours")
    plt.xlabel("Study Hours")
    plt.ylabel("Number of Students")

    plt.show()

    # ----------------------------------------
    # Scatter Plot
    # StudyHours vs PreviousScore
    # ----------------------------------------

    plt.figure(figsize=(8, 5))

    pass_students = df[df["FinalResult"] == 1]
    fail_students = df[df["FinalResult"] == 0]

    plt.scatter(
        pass_students["StudyHours"],
        pass_students["PreviousScore"],
        label="Pass"
    )

    plt.scatter(
        fail_students["StudyHours"],
        fail_students["PreviousScore"],
        label="Fail"
    )

    plt.title("StudyHours vs PreviousScore")
    plt.xlabel("Study Hours")
    plt.ylabel("Previous Score")
    plt.legend()

    plt.show()

    # ----------------------------------------
    # Attendance Boxplot
    # ----------------------------------------

    plt.figure(figsize=(8, 5))

    plt.boxplot(df["Attendance"])

    plt.title("Attendance Boxplot")
    plt.ylabel("Attendance")

    plt.show()


def analyze_student_performance(df):
    """
    Analyze StudyHours, Attendance,
    AssignmentsCompleted and SleepHours.
    """

    print("\n========== PERFORMANCE ANALYSIS ==========")

    study_hours = df.groupby(
        "FinalResult"
    )["StudyHours"].mean()

    attendance = df.groupby(
        "FinalResult"
    )["Attendance"].mean()

    assignments = df.groupby(
        "FinalResult"
    )["AssignmentsCompleted"].mean()

    sleep_hours = df.groupby(
        "FinalResult"
    )["SleepHours"].mean()

    print("\nAverage StudyHours:")
    print(study_hours)

    print("\nAverage Attendance:")
    print(attendance)

    print("\nAverage AssignmentsCompleted:")
    print(assignments)

    print("\nAverage SleepHours:")
    print(sleep_hours)

    if study_hours[1] > study_hours[0]:
        print("\nHigher StudyHours generally increase the chance of passing.")

    if attendance[1] > attendance[0]:
        print("Higher Attendance generally improves FinalResult.")

    if assignments[1] > assignments[0]:
        print("Students completing more assignments tend to perform better.")

    print("Sleeping more does not necessarily guarantee success.")


def prepare_train_test_data(df):
    """
    Separate input features and target variable
    and perform train-test split.
    """

    features = [
        "StudyHours",
        "Attendance",
        "PreviousScore",
        "AssignmentsCompleted",
        "SleepHours"
    ]

    X = df[features]

    y = df["FinalResult"]

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.20,
        random_state=42,
        stratify=y
    )

    print("\n========== TRAIN TEST SPLIT ==========")

    print("Training records:", len(X_train))
    print("Testing records:", len(X_test))

    return X_train, X_test, y_train, y_test


def train_decision_tree(X_train, y_train):
    """
    Create and train Decision Tree Classifier.
    """

    model = DecisionTreeClassifier(
        random_state=42
    )

    model.fit(X_train, y_train)

    print("\n========== MODEL TRAINING ==========")
    print("Decision Tree model trained successfully.")

    return model


def predict_student_results(model, X_test, y_test):
    """
    Predict results for test data
    and display actual and predicted values.
    """

    predictions = model.predict(X_test)

    result = pd.DataFrame({
        "Actual": y_test.values,
        "Predicted": predictions
    })

    print("\n========== PREDICTIONS ==========")
    print(result)

    return predictions


def calculate_model_accuracy(y_test, predictions):
    """
    Calculate testing accuracy.
    """

    accuracy = accuracy_score(
        y_test,
        predictions
    )

    print("\n========== TESTING ACCURACY ==========")

    print(
        "Testing Accuracy:",
        round(accuracy * 100, 2),
        "%"
    )

    return accuracy


def main():

    # 1. Dataset loading
    df = load_dataset()

    # 2. Data analysis
    analyze_data(df)

    # 3. Visualization
    create_visualizations(df)

    # Additional performance analysis
    analyze_student_performance(df)

    # 4. Train-test split
    X_train, X_test, y_train, y_test = prepare_train_test_data(df)

    # 5. Model training
    model = train_decision_tree(
        X_train,
        y_train
    )

    # 6. Prediction
    predictions = predict_student_results(
        model,
        X_test,
        y_test
    )

    # 7. Accuracy calculation
    calculate_model_accuracy(
        y_test,
        predictions
    )



if __name__ == "__main__":
    main()